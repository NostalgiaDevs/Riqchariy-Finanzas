# --- App ---
APP_NAME=riqchariy
APP_ENV=development                    # development | staging | production
APP_DEBUG=true
APP_PORT=8000
APP_SECRET_KEY=cambiar-esto-con-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:5173     # URL del frontend en dev

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://riqchariy:password@localhost:5432/riqchariy_db
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false                    # true para ver SQL en logs (solo dev)

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- pgvector (extensión de PostgreSQL para RAG) ---
PGVECTOR_DIMENSION=1536               # dimensión de embeddings

# --- Claude API (para Qori chatbot) ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=200
CLAUDE_TEMPERATURE=0.7

# --- Auth ---
JWT_SECRET=cambiar-esto-con-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440               # 24 horas

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Riqchariy
VITE_WS_URL=ws://localhost:8000/ws

# --- Deploy: Render ---
# (configurar directamente en Render dashboard)
# RENDER_DATABASE_URL=postgresql://...
# RENDER_REDIS_URL=redis://...

# --- Deploy: Vercel ---
# (configurar en Vercel dashboard)
# VITE_API_URL=https://api.riqchariy.com/api/v1

# --- Semilla del simulador ---
PACHA_DEFAULT_SEED=42                  # semilla para RNG determinista
PACHA_TICKS_PER_MONTH=28

# --- Rate limiting ---
RATE_LIMIT_CHATBOT=10/minute           # límite de mensajes a Qori por usuario
RATE_LIMIT_API=100/minute              # límite general de API
