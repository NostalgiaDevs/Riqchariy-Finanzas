# --- ARCHIVOS DE CONFIGURACIÓN PERSONAL / SECRETOS ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# --- ENTORNOS VIRTUALES Y DEPENDENCIAS GENERALES ---
node_modules/
bower_components/
# Ancladas a la raíz o a nivel de backend para no ignorar carpetas
# legítimas del código (p. ej. frontend/src/lib/)
venv/
.venv/
/env/
/ENV/
/backend/build/
/backend/dist/
/backend/wheels/
*.egg-info/
# --- PYTHON CACHE ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- EDITORES DE CÓDIGO (IDE) ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- SISTEMA OPERATIVO ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.Trashes

# --- ARCHIVOS DE REGISTRO Y TEMPORALES (LOGS) ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
